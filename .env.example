# ========================
# Application
# ========================
APP_NAME=Conversational AI Platform
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ========================
# Security
# ========================
SECRET_KEY=replace-with-a-strong-random-string-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

# ========================
# Database (SQLite)
# ========================
DATABASE_URL=sqlite+aiosqlite:///./data/memory_chat.db

# ========================
# Groq LLM
# ========================
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ========================
# CORS
# ========================
FRONTEND_URL=http://localhost:5173

# ========================
# Frontend / Vite
# ========================
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000



# ========================
# Token Budget
# ========================
TOKEN_BUDGET_TOTAL=4000
TOKEN_BUDGET_SYSTEM=500
TOKEN_BUDGET_MEMORY=1000
TOKEN_BUDGET_RECENT=1500
TOKEN_BUDGET_RESPONSE=1000

# ========================
# Memory Settings
# ========================
SUMMARY_INTERVAL=5
MAX_RECENT_MESSAGES=10
AUTO_SWITCH_THRESHOLD=15
